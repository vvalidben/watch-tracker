# Copy this file to .env and fill in your own values.
# .env is gitignored — never commit real API keys.

# Required for movie/TV search. Get a free key at https://www.themoviedb.org/settings/api
TMDB_API_KEY=

# Optional overrides — sensible defaults are used if omitted.
# TMDB_API_BASE_URL=https://api.themoviedb.org/3
# TMDB_IMAGE_BASE_URL=https://image.tmdb.org/t/p

# Anime search uses AniList's public GraphQL API, which needs no API key.
# ANILIST_API_URL=https://graphql.anilist.co
